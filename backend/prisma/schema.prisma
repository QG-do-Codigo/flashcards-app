generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String
  streak        Int       @default(0)
  lastStudyDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  decks         Deck[]
  studySessions StudySession[]
  badges        Badge[]

  @@map("users")
}

model Deck {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#4F46E5")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  cards       Card[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  studySessions StudySession[]

  @@map("decks")
}

model Card {
  id          String   @id @default(uuid())
  front       String   // Texto da frente (pergunta)
  back        String   // Texto do verso (resposta)
  example     String?  // Exemplo de uso (opcional)
  audioUrl    String?  // URL para áudio (opcional)
  deckId      String
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  // Campos para o algoritmo SM-2
  difficulty  Int      @default(3) // 1-5 (1: muito difícil, 5: muito fácil)
  nextReview  DateTime @default(now()) // Próxima data de revisão
  interval    Int      @default(1) // Intervalo em dias
  easeFactor  Float    @default(2.5) // Fator de facilidade
  reviewCount Int      @default(0) // Número de vezes revisado
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deckId])
  @@index([nextReview])
  @@unique([front, deckId])
  @@map("cards")
}

model StudySession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id])
  cardsReviewed Int  @default(0)
  correctAnswers Int @default(0)
  duration  Int      @default(0) // in seconds
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("study_sessions")
}

model Badge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        BadgeType
  earnedAt    DateTime @default(now())
  title       String
  description String
  icon        String

  @@map("badges")
}

enum BadgeType {
  FIRST_DECK
  STREAK_7
  STREAK_30
  PERFECT_SESSION
  FAST_LEARNER
  DECK_MASTER
}